# Enforces the project coding standard: tabs for indentation at the start of
# every line, across all languages and editors.
root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
# YAML is whitespace-sensitive and the GitHub Actions ecosystem assumes spaces.
indent_style = space
indent_size = 2
